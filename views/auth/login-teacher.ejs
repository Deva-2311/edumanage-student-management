<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Teacher Login — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
  <style>
    body{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem;margin-left:0}
    #main{margin-left:0}
    .login-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:32px;width:100%;max-width:400px;box-shadow:0 4px 16px rgba(0,0,0,0.06)}
    .pw-wrap{position:relative}
    .pw-wrap input{padding-right:38px}
    .pw-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:#94a3b8;cursor:pointer;font-size:0.85rem;padding:0}
  </style>
</head>
<body>
<div class="login-card">
  <a href="/api/login" style="font-size:0.78rem;color:#64748b;text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:20px">← Back to portals</a>
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:22px">
    <div style="width:38px;height:38px;background:#d1fae5;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1.1rem">👩‍🏫</div>
    <div>
      <div style="font-size:0.95rem;font-weight:800;color:#191c1e">EduManage</div>
      <span style="font-size:0.7rem;font-weight:600;background:#d1fae5;color:#059669;padding:2px 8px;border-radius:99px">Teacher Portal</span>
    </div>
  </div>
  <h2 style="font-size:1.1rem;font-weight:700;color:#191c1e;margin-bottom:4px">Sign in to your account</h2>
  <p style="font-size:0.78rem;color:#64748b;margin-bottom:20px">Enter your credentials to continue</p>
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error">✗ <%= error %></div>
  <% } %>
  <form method="POST" action="/api/login">
    <input type="hidden" name="portal" value="teacher"/>
    <div class="form-group">
      <label class="form-label" for="email">Email Address</label>
      <input type="email" id="email" name="email" class="form-input" placeholder="teacher@institution.edu" required autocomplete="email"/>
    </div>
    <div class="form-group">
      <label class="form-label" for="password">Password</label>
      <div class="pw-wrap">
        <input type="password" id="password" name="password" class="form-input" placeholder="Enter password" required autocomplete="current-password"/>
        <button type="button" class="pw-toggle" onclick="this.previousElementSibling.type=this.previousElementSibling.type==='password'?'text':'password'">👁</button>
      </div>
    </div>
    <button type="submit" class="btn" style="width:100%;justify-content:center;padding:10px;font-size:0.85rem;margin-top:4px;background:#059669;color:#fff">Sign In →</button>
  </form>
  <p style="text-align:center;font-size:0.7rem;color:#94a3b8;margin-top:20px">© 2026 EduManage · Smackcoders</p>
</div>
</body>
</html>