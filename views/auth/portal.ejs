<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>EduManage — Choose Portal</title>
  <meta name="description" content="EduManage — Select your portal to sign in."/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',sans-serif;min-height:100vh;background:#f7f9fb;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem}
    .portal-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:28px 24px;text-align:center;text-decoration:none;transition:all 0.2s;cursor:pointer;display:block}
    .portal-card:hover{border-color:#4f46e5;box-shadow:0 4px 20px rgba(79,70,229,0.10);transform:translateY(-2px)}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;width:100%;max-width:820px}
    h1{font-size:1.5rem;font-weight:700;color:#191c1e;margin-bottom:6px}
    .sub{color:#64748b;font-size:0.85rem;margin-bottom:2rem}
    .portal-icon{width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 14px}
    .portal-role{font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:2px 8px;border-radius:99px;display:inline-block;margin-bottom:8px}
    .portal-title{font-size:1rem;font-weight:700;color:#191c1e;margin-bottom:6px}
    .portal-desc{font-size:0.78rem;color:#64748b;line-height:1.6;margin-bottom:16px}
    .portal-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:6px;font-size:0.8rem;font-weight:600;color:#fff;transition:all 0.14s}
    .logo{display:flex;align-items:center;gap:10px;margin-bottom:2rem}
    .logo-icon{width:40px;height:40px;background:linear-gradient(135deg,#4f46e5,#7c3aed);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem}
    .logo-name{font-size:1.3rem;font-weight:800;color:#191c1e}
    footer{margin-top:2.5rem;font-size:0.72rem;color:#94a3b8}
  </style>
</head>
<body>
  <div class="logo"><div class="logo-icon">🎓</div><span class="logo-name">EduManage</span></div>
  <h1>Welcome back</h1>
  <p class="sub">Select your portal to sign in</p>

  <div class="grid">
    <a href="/api/login/admin" class="portal-card">
      <div class="portal-icon" style="background:#ede9fe">🛡️</div>
      <span class="portal-role" style="background:#ede9fe;color:#4f46e5">Admin</span>
      <div class="portal-title">Admin Portal</div>
      <div class="portal-desc">Full system access — manage students, courses, staff, and audit logs.</div>
      <span class="portal-btn" style="background:#4f46e5">Sign In →</span>
    </a>

    <a href="/api/login/teacher" class="portal-card">
      <div class="portal-icon" style="background:#d1fae5">👩‍🏫</div>
      <span class="portal-role" style="background:#d1fae5;color:#059669">Teacher</span>
      <div class="portal-title">Teacher Portal</div>
      <div class="portal-desc">Record attendance, enter marks, and track student performance.</div>
      <span class="portal-btn" style="background:#059669">Sign In →</span>
    </a>

    <a href="/api/login/student" class="portal-card">
      <div class="portal-icon" style="background:#ede9fe">🎒</div>
      <span class="portal-role" style="background:#ede9fe;color:#7c3aed">Student</span>
      <div class="portal-title">Student Portal</div>
      <div class="portal-desc">View your grades, attendance, and enrolled courses.</div>
      <span class="portal-btn" style="background:#7c3aed">Sign In →</span>
    </a>
  </div>

  <footer>© 2026 EduManage · Smackcoders Internship Capstone</footer>
</body>
</html>