<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<aside id="sidebar">
  <div class="sidebar-brand">
    <div class="sidebar-brand-icon">🎓</div>
    <div><div class="sidebar-brand-text">EduManage</div><div class="sidebar-brand-sub">Student Portal</div></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/api/student-portal" class="sidebar-nav-item"><span class="icon">📊</span><span>My Dashboard</span></a>
    <a href="/api/student-portal/marks" class="sidebar-nav-item active"><span class="icon">📝</span><span>My Marks</span></a>
    <a href="/api/student-portal/attendance" class="sidebar-nav-item"><span class="icon">📅</span><span>My Attendance</span></a>
    <div class="sidebar-divider"></div>
    <a href="/api/student-portal/password" class="sidebar-nav-item"><span class="icon">🔐</span><span>Change Password</span></a>
  </nav>
  <div class="sidebar-footer">
    <div class="sidebar-user"><div class="avatar avatar-violet"><%= (user?.name??'S').charAt(0).toUpperCase() %></div><div><div class="sidebar-user-name"><%= user?.name %></div><div class="sidebar-user-role" style="color:#a78bfa">Student</div></div></div>
    <a href="/api/logout" class="sidebar-nav-item" style="color:#fca5a5"><span class="icon">🚪</span><span>Logout</span></a>
  </div>
</aside>
<div id="main">
  <div class="topbar">
    <span style="font-size:0.82rem;font-weight:600;color:#191c1e">My Marks</span>
    <div class="avatar avatar-violet"><%= (user?.name??'S').charAt(0).toUpperCase() %></div>
  </div>
  <div class="page-body">
    <div class="page-header"><div><h1 class="page-title">My Academic Record</h1><p class="page-subtitle">Performance across all courses and exams</p></div></div>

    <% if(!student){ %>
    <div class="alert alert-warning">No student record linked. Contact admin.</div>
    <% } else if(!marks.length){ %>
    <div class="card card-body"><div class="empty-state"><div class="empty-icon">📝</div><p>No marks records yet.</p></div></div>
    <% } else {
      const avg=(marks.reduce((s,m)=>s+(m.marks_obtained/m.max_marks)*100,0)/marks.length).toFixed(1);
    %>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px">
      <div class="card stat-card"><div class="stat-label">Avg Score</div><div class="stat-value" style="color:<%=avg>=80?'#059669':avg>=60?'#d97706':'#be123c'%>"><%= avg %>%</div></div>
      <div class="card stat-card"><div class="stat-label">Total Exams</div><div class="stat-value"><%= marks.length %></div></div>
      <div class="card stat-card"><div class="stat-label">A / A+ Grades</div><div class="stat-value" style="color:#059669"><%= marks.filter(m=>m.grade==='A'||m.grade==='A+').length %></div></div>
      <div class="card stat-card"><div class="stat-label">F Grades</div><div class="stat-value" style="color:#be123c"><%= marks.filter(m=>m.grade==='F').length %></div></div>
    </div>
    <div class="card">
      <table class="data-table">
        <thead><tr><th>Course</th><th>Exam Type</th><th>Score</th><th>%</th><th>Grade</th></tr></thead>
        <tbody>
          <% marks.forEach(m=>{ const pct=Math.round((m.marks_obtained/m.max_marks)*100); const gc=m.grade==='A+'?'grade-ap':m.grade==='A'?'grade-a':m.grade==='B'?'grade-b':m.grade==='C'?'grade-c':m.grade==='D'?'grade-d':'grade-f'; %>
          <tr>
            <td style="font-weight:500;color:#191c1e"><%= m.course?.course_name %></td>
            <td><span class="badge badge-violet"><%= m.exam_type %></span></td>
            <td style="font-family:'JetBrains Mono',monospace"><%= m.marks_obtained %>/<%= m.max_marks %></td>
            <td>
              <div style="display:flex;align-items:center;gap:8px">
                <div class="progress-bar" style="width:70px"><div class="progress-fill <%=pct>=80?'progress-emerald':pct>=60?'progress-amber':'progress-rose'%>" style="width:<%=pct%>%"></div></div>
                <span style="font-size:0.78rem;font-weight:600;color:<%=pct>=80?'#059669':pct>=60?'#d97706':'#be123c'%>"><%= pct %>%</span>
              </div>
            </td>
            <td><span class="badge <%= gc %>"><%= m.grade %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
</body>
</html>
