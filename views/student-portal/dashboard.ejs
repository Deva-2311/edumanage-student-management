<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<!-- Student Portal sidebar -->
<aside id="sidebar">
  <div class="sidebar-brand">
    <div class="sidebar-brand-icon">🎓</div>
    <div><div class="sidebar-brand-text">EduManage</div><div class="sidebar-brand-sub">Student Portal</div></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/api/student-portal" class="sidebar-nav-item <%= currentPage==='portal-dashboard'?'active':'' %>"><span class="icon">📊</span><span>My Dashboard</span></a>
    <a href="/api/student-portal/marks" class="sidebar-nav-item <%= currentPage==='portal-marks'?'active':'' %>"><span class="icon">📝</span><span>My Marks</span></a>
    <a href="/api/student-portal/attendance" class="sidebar-nav-item <%= currentPage==='portal-attendance'?'active':'' %>"><span class="icon">📅</span><span>My Attendance</span></a>
    <div class="sidebar-divider"></div>
    <a href="/api/student-portal/password" class="sidebar-nav-item <%= currentPage==='portal-password'?'active':'' %>"><span class="icon">🔐</span><span>Change Password</span></a>
  </nav>
  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="avatar avatar-violet"><%= (user?.name??'S').charAt(0).toUpperCase() %></div>
      <div><div class="sidebar-user-name"><%= user?.name %></div><div class="sidebar-user-role" style="color:#a78bfa">Student</div></div>
    </div>
    <a href="/api/logout" class="sidebar-nav-item" style="color:#fca5a5"><span class="icon">🚪</span><span>Logout</span></a>
  </div>
</aside>
<div id="sidebar-overlay" onclick="closeSidebarMobile()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:49"></div>

<div id="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:10px">
      <button id="menu-btn" onclick="toggleSidebarMobile()" style="display:none;background:none;border:none;color:#64748b;font-size:1.1rem;cursor:pointer">☰</button>
      <span style="font-size:0.82rem;font-weight:600;color:#191c1e">My Dashboard</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <div class="avatar avatar-violet"><%= (user?.name??'S').charAt(0).toUpperCase() %></div>
      <div><div style="font-size:0.78rem;font-weight:600;color:#191c1e"><%= user?.name %></div><div style="font-size:0.68rem;color:#7c3aed">Student</div></div>
    </div>
  </div>

  <div class="page-body">
    <% if(!student){ %>
    <div class="alert alert-warning">⚠️ No student record linked to your account. Contact your administrator.</div>
    <% } else { %>

    <div class="page-header">
      <div><h1 class="page-title">Welcome back, <%= student.name %>!</h1><p class="page-subtitle"><%= new Date().toLocaleDateString('en-IN',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %></p></div>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px">
      <% [['📚','Enrolled Courses',student.enrollments?.length??0,'#4f46e5'],['📝','Marks Records',student.marks?.length??0,'#0284c7'],['📅','Attendance',student.attendance?.length??0,'#059669']].forEach(([icon,l,v,c])=>{ %>
      <div class="card stat-card">
        <div style="font-size:1.5rem;margin-bottom:8px"><%= icon %></div>
        <div class="stat-label"><%= l %></div>
        <div class="stat-value" style="color:<%= c %>"><%= v %></div>
      </div>
      <% }) %>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
      <div class="card">
        <div class="card-header"><span class="card-title">My Profile</span></div>
        <div class="card-body">
          <% [['ID','STU-'+String(student.id).padStart(4,'0')],['Name',student.name],['Email',student.email],['Department',student.department],['Age',student.age+' yrs'],['City',student.city||'—']].forEach(([l,v])=>{ %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:0.8rem">
            <span style="color:#64748b"><%= l %></span><span style="font-weight:500;color:#191c1e"><%= v %></span>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><span class="card-title">My Courses</span></div>
        <div class="card-body">
          <% if(!student.enrollments?.length){ %>
          <div class="empty-state" style="padding:20px 0"><div class="empty-icon">📋</div><p>No courses enrolled</p></div>
          <% } else { student.enrollments.forEach(e=>{ %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:0.8rem">
            <div><div style="font-weight:500;color:#191c1e"><%= e.course?.course_name %></div><div style="font-size:0.72rem;color:#94a3b8"><%= e.course?.department %></div></div>
            <span class="badge <%=e.status==='active'?'badge-indigo':e.status==='completed'?'badge-emerald':'badge-slate'%>"><%= e.status %></span>
          </div>
          <% }) } %>
        </div>
      </div>
    </div>

    <!-- Quick links -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <a href="/api/student-portal/marks" style="display:flex;align-items:center;gap:14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:16px;text-decoration:none">
        <span style="font-size:1.5rem">📝</span>
        <div><div style="font-weight:700;color:#1d4ed8;font-size:0.88rem">View My Marks</div><div style="font-size:0.75rem;color:#3b82f6">Academic performance records</div></div>
      </a>
      <a href="/api/student-portal/attendance" style="display:flex;align-items:center;gap:14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:16px;text-decoration:none">
        <span style="font-size:1.5rem">📅</span>
        <div><div style="font-weight:700;color:#15803d;font-size:0.88rem">View My Attendance</div><div style="font-size:0.75rem;color:#16a34a">Session attendance history</div></div>
      </a>
    </div>
    <% } %>
  </div>
</div>
<script>
  function toggleSidebarMobile(){const sb=document.getElementById('sidebar');const ov=document.getElementById('sidebar-overlay');const open=sb.classList.toggle('mobile-open');ov.style.display=open?'block':'none';}
  function closeSidebarMobile(){document.getElementById('sidebar').classList.remove('mobile-open');document.getElementById('sidebar-overlay').style.display='none';}
  if(window.innerWidth<=768)document.getElementById('menu-btn').style.display='block';
</script>
</body>
</html>
