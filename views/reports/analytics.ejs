<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user }) %>
  <div class="page-body">
    <h1 class="page-title">Advanced Analytics</h1>
    <p class="page-subtitle">Department performance and attendance predictions</p>
    
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:24px; margin-top:24px;">
      <div class="card card-body" style="padding:24px;">
        <h3>Department Heatmap (Avg Score)</h3>
        <ul style="list-style:none; padding:0; margin-top:16px">
          <% for(let dept in heatmap) { %>
            <li style="margin-bottom:12px; display:flex; justify-content:space-between; padding:8px; background:<%= heatmap[dept] > 90 ? '#d1fae5' : (heatmap[dept] > 80 ? '#e0e7ff' : '#fee2e2') %>; border-radius:4px;">
              <strong><%= dept %></strong>
              <span><%= heatmap[dept] %>%</span>
            </li>
          <% } %>
        </ul>
      </div>

      <div class="card card-body" style="padding:24px;">
        <h3>Attendance Prediction</h3>
        <div style="font-size:3rem; font-weight:800; color:#3b49df; margin-top:16px;">
          <%= prediction.nextWeekPrediction %>%
        </div>
        <p style="color:#64748b; font-size:0.9rem;">Predicted average attendance for next week.</p>
        <p style="margin-top:8px;">Trend: <strong><%= prediction.trend %></strong></p>
      </div>
    </div>
  </div>
</div>
</body>
</html>
