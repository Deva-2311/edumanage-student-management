<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    h1 { color: #3b49df; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; }
    .info { margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #cbd5e1; padding: 8px; text-align: left; }
    th { background: #f1f5f9; }
  </style>
</head>
<body>
  <h1>Official Transcript</h1>
  <div class="info">
    <p><strong>Student Name:</strong> <%= student.name %></p>
    <p><strong>Student ID:</strong> STU-<%= String(student.id).padStart(4,'0') %></p>
    <p><strong>Department:</strong> <%= student.department %></p>
  </div>
  
  <h2>Academic Records</h2>
  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Exam Type</th>
        <th>Marks</th>
        <th>Grade</th>
      </tr>
    </thead>
    <tbody>
      <% if (student.marks && student.marks.length > 0) { %>
        <% student.marks.forEach(m => { %>
        <tr>
          <td><%= m.course?.course_name %></td>
          <td><%= m.exam_type %></td>
          <td><%= m.marks_obtained %> / <%= m.max_marks %></td>
          <td><%= m.grade %></td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="4">No marks recorded yet.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</body>
</html>
