<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Marks › Edit' }) %>
  <div class="page-body" style="max-width:900px">
    <a href="/api/marks" style="font-size:0.78rem;color:#64748b;text-decoration:none;margin-bottom:14px;display:inline-block">← Back to Marks</a>
    <div class="page-header"><div><h1 class="page-title">Edit Marks</h1><p class="page-subtitle">Update marks for <%= mark.student?.name %></p></div></div>
    <% if(error){ %><div class="alert alert-error">✗ <%= error %></div><% } %>

    <div style="display:grid;grid-template-columns:1fr 260px;gap:16px">
      <div class="card card-body">
        <!-- Info banner -->
        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:12px 16px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:18px">
          <div><div style="font-size:0.68rem;color:#64748b;margin-bottom:3px">Student</div><div style="font-weight:600;color:#191c1e;font-size:0.82rem"><%= mark.student?.name %></div></div>
          <div><div style="font-size:0.68rem;color:#64748b;margin-bottom:3px">Course</div><div style="font-weight:600;color:#191c1e;font-size:0.82rem"><%= mark.course?.course_name %></div></div>
          <div><div style="font-size:0.68rem;color:#64748b;margin-bottom:3px">Current Grade</div><div style="font-weight:800;color:#4f46e5;font-size:1.1rem;font-family:'JetBrains Mono',monospace"><%= mark.grade %></div></div>
        </div>
        <form method="POST" action="/api/marks/<%= mark.id %>/edit">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
            <div class="form-group">
              <label class="form-label">Exam Type</label>
              <select name="exam_type" class="form-select" oninput="calcGrade()">
                <% ['Midterm','Final Exam','Assignment','Quiz','Lab','Project'].forEach(t=>{%><option <%=mark.exam_type===t?'selected':''%>><%= t %></option><% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Maximum Marks</label>
              <input type="number" name="max_marks" id="max_marks" value="<%= mark.max_marks %>" class="form-input" oninput="calcGrade()" required/>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Marks Obtained</label>
            <input type="number" name="marks_obtained" id="marks_obtained" value="<%= mark.marks_obtained %>" class="form-input" oninput="calcGrade()" step="0.01" required/>
          </div>
          <div style="border-top:1px solid #e2e8f0;margin-top:16px;padding-top:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
            <div style="display:flex;gap:10px">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <a href="/api/marks" class="btn btn-secondary">Cancel</a>
            </div>
            <form id="dm" method="POST" action="/api/marks/<%= mark.id %>/delete">
              <button type="button" class="btn btn-danger" onclick="confirmDelete('dm','this mark record')">Delete Record</button>
            </form>
          </div>
        </form>
      </div>

      <div class="grade-preview" id="grade-card" style="align-self:start">
        <div style="font-size:0.65rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px">Updated Grade</div>
        <div class="grade-letter" id="grade-letter" style="color:#4f46e5"><%= mark.grade %></div>
        <div class="grade-pct" id="grade-pct"><%= mark.marks_obtained %>/<%= mark.max_marks %> = <%= Math.round((mark.marks_obtained/mark.max_marks)*100) %>%</div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script>
  const gd=[{min:90,g:'A+',c:'#059669',bg:'rgba(5,150,105,0.08)'},{min:80,g:'A',c:'#34d399',bg:'rgba(52,211,153,0.08)'},{min:70,g:'B',c:'#0284c7',bg:'rgba(2,132,199,0.08)'},{min:60,g:'C',c:'#d97706',bg:'rgba(217,119,6,0.08)'},{min:50,g:'D',c:'#ea580c',bg:'rgba(234,88,12,0.08)'},{min:0,g:'F',c:'#be123c',bg:'rgba(190,18,60,0.08)'}];
  function calcGrade(){
    const m=parseFloat(document.getElementById('marks_obtained').value);
    const mx=parseFloat(document.getElementById('max_marks').value)||100;
    const l=document.getElementById('grade-letter'),p=document.getElementById('grade-pct'),card=document.getElementById('grade-card');
    if(isNaN(m)){l.textContent='--';l.style.color='#cbd5e1';p.textContent='';card.style.background='#f2f4f6';return;}
    const pct=Math.round((m/mx)*100);const gr=gd.find(x=>pct>=x.min)||gd[5];
    l.textContent=gr.g;l.style.color=gr.c;p.textContent=`${m}/${mx} = ${pct}%`;card.style.background=gr.bg;
  }
  calcGrade();
</script>
</body>
</html>
