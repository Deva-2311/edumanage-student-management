<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Marks' }) %>
  <div class="page-body">
    <div class="page-header">
      <div><h1 class="page-title">Marks Management</h1><p class="page-subtitle">Academic performance records and grade analytics</p></div>
      <% if(user?.role!=='student'){%><a href="/api/marks/add" class="btn btn-primary">+ Add Marks</a><% }%>
    </div>

    <!-- Grade distribution -->
    <div style="display:grid;grid-template-columns:1fr 280px;gap:14px;margin-bottom:14px">
      <div class="card card-body" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
        <span style="font-size:0.72rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:0.06em;margin-right:6px">Grade Distribution:</span>
        <% Object.entries(gradeCount).forEach(([g,c])=>{ const gc=g==='A+'?'grade-ap':g==='A'?'grade-a':g==='B'?'grade-b':g==='C'?'grade-c':g==='D'?'grade-d':'grade-f'; %>
        <span class="badge <%= gc %>" style="padding:4px 12px;font-size:0.8rem"><%= g %> <span style="opacity:0.7;font-size:0.72rem">(<%= c %>)</span></span>
        <% }) %>
      </div>
      <div class="card card-body" style="display:flex;align-items:center;gap:14px">
        <canvas id="gradeChart" style="max-width:80px;max-height:80px;flex-shrink:0"></canvas>
        <div style="font-size:0.72rem;color:#64748b">Grade<br>breakdown</div>
      </div>
    </div>

    <!-- Search -->
    <div class="card card-body" style="margin-bottom:14px">
      <form method="GET" action="/api/marks" style="display:flex;gap:10px;flex-wrap:wrap">
        <div class="search-wrap" style="flex:1;min-width:200px">
          <span class="search-icon">🔍</span>
          <input type="text" name="search" value="<%= search %>" placeholder="Search by student or course…" class="form-input"/>
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
        <% if(search){%><a href="/api/marks" class="btn btn-secondary">Clear</a><% }%>
      </form>
    </div>

    <div class="card">
      <div style="overflow-x:auto">
        <table class="data-table">
          <thead><tr><th>Student</th><th>Course</th><th>Exam</th><th>Score</th><th>%</th><th>Grade</th><th>Actions</th></tr></thead>
          <tbody>
            <% if(!marks.length){ %>
            <tr><td colspan="7"><div class="empty-state"><div class="empty-icon">📝</div><p>No marks recorded</p><a href="/api/marks/add" class="btn btn-primary btn-sm">+ Add First Record</a></div></td></tr>
            <% } else { marks.forEach(m=>{ const pct=Math.round((m.marks_obtained/m.max_marks)*100); const gc=m.grade==='A+'?'grade-ap':m.grade==='A'?'grade-a':m.grade==='B'?'grade-b':m.grade==='C'?'grade-c':m.grade==='D'?'grade-d':'grade-f'; %>
            <tr>
              <td><div style="display:flex;align-items:center;gap:8px"><div class="avatar avatar-indigo"><%= (m.student?.name??'?').charAt(0).toUpperCase() %></div><span style="font-weight:500;color:#191c1e"><%= m.student?.name %></span></div></td>
              <td><%= m.course?.course_name %></td>
              <td><span class="badge badge-violet"><%= m.exam_type %></span></td>
              <td style="font-family:'JetBrains Mono',monospace"><%= m.marks_obtained %>/<%= m.max_marks %></td>
              <td style="font-weight:600;color:<%=pct>=80?'#059669':pct>=60?'#d97706':'#be123c'%>"><%= pct %>%</td>
              <td><span class="badge <%= gc %>"><%= m.grade %></span></td>
              <td>
                <div style="display:flex;gap:6px">
                  <% if(user?.role!=='student'){%><a href="/api/marks/<%= m.id %>/edit" class="btn btn-secondary btn-sm">Edit</a><% }%>
                  <form id="dm<%= m.id %>" method="POST" action="/api/marks/<%= m.id %>/delete">
                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete('dm<%=m.id%>','this mark record')">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) } %>
          </tbody>
        </table>
      </div>
      <div class="table-footer">
        <span class="table-meta">Showing <%= Math.min((page-1)*limit+1,total) %> – <%= Math.min(page*limit,total) %> of <%= total %> records</span>
        <div class="pagination">
          <% for(let i=1;i<=totalPages;i++){%><a href="/api/marks?page=<%=i%>" class="page-btn <%=i===page?'active':''%>"><%=i%></a><% }%>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script>
  const gc=<%- JSON.stringify(gradeCount) %>;
  const cols={'A+':'#059669','A':'#34d399','B':'#0284c7','C':'#d97706','D':'#ea580c','F':'#be123c'};
  const labels=Object.keys(gc),vals=Object.values(gc);
  if(document.getElementById('gradeChart')&&vals.some(v=>v>0)){
    new Chart(document.getElementById('gradeChart'),{type:'doughnut',data:{labels,datasets:[{data:vals,backgroundColor:labels.map(l=>cols[l]||'#4f46e5'),borderWidth:0,hoverOffset:4}]},options:{cutout:'70%',plugins:{legend:{display:false}}}});
  }
</script>
</body>
</html>