<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Marks › Add' }) %>
  <div class="page-body" style="max-width:900px">
    <a href="/api/marks" style="font-size:0.78rem;color:#64748b;text-decoration:none;margin-bottom:14px;display:inline-block">← Back to Marks</a>
    <div class="page-header"><div><h1 class="page-title">Record Student Marks</h1><p class="page-subtitle">Grade calculates automatically as you type</p></div></div>
    <% if(error){ %><div class="alert alert-error">✗ <%= error %></div><% } %>

    <div style="display:grid;grid-template-columns:1fr 260px;gap:16px">
      <div class="card card-body">
        <form method="POST" action="/api/marks/add">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
            <div class="form-group">
              <label class="form-label">Student *</label>
              <select name="student_id" class="form-select" required>
                <option value="">Select student…</option>
                <% students.forEach(s=>{%><option value="<%= s.id %>"><%= s.name %> — <%= s.department %></option><% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Course *</label>
              <select name="course_id" class="form-select" required>
                <option value="">Select course…</option>
                <% courses.forEach(c=>{%><option value="<%= c.id %>"><%= c.course_code %> — <%= c.course_name %></option><% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Exam Type *</label>
              <select name="exam_type" class="form-select" required>
                <option value="">Select type…</option>
                <% ['Midterm','Final Exam','Assignment','Quiz','Lab','Project'].forEach(t=>{%><option><%= t %></option><% }) %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Maximum Marks *</label>
              <input type="number" name="max_marks" id="max_marks" value="100" min="1" class="form-input" oninput="calcGrade()" required/>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Marks Obtained *</label>
            <input type="number" name="marks_obtained" id="marks_obtained" placeholder="Enter marks" min="0" step="0.01" class="form-input" oninput="calcGrade()" required/>
          </div>
          <div style="border-top:1px solid #e2e8f0;margin-top:16px;padding-top:16px;display:flex;gap:10px">
            <button type="submit" class="btn btn-primary">Save Marks</button>
            <a href="/api/marks" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>

      <!-- Live Grade Preview -->
      <div class="grade-preview" id="grade-card" style="align-self:start">
        <div style="font-size:0.65rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px">Live Grade Preview</div>
        <div class="grade-letter" id="grade-letter" style="color:#cbd5e1">--</div>
        <div class="grade-pct" id="grade-pct">Enter marks above</div>
        <div style="border-top:1px solid #e2e8f0;margin:14px 0;padding-top:14px">
          <div style="font-size:0.68rem;font-weight:600;color:#64748b;margin-bottom:8px">GRADE SCALE</div>
          <% [['A+','90–100%','#059669'],['A','80–89%','#34d399'],['B','70–79%','#0284c7'],['C','60–69%','#d97706'],['D','50–59%','#ea580c'],['F','< 50%','#be123c']].forEach(([g,r,c])=>{ %>
          <div style="display:flex;justify-content:space-between;font-size:0.72rem;margin-bottom:4px">
            <span style="font-weight:700;color:<%= c %>;font-family:'JetBrains Mono',monospace"><%= g %></span>
            <span style="color:#94a3b8"><%= r %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
<script>
  const gd=[{min:90,g:'A+',c:'#059669',bg:'rgba(5,150,105,0.08)'},{min:80,g:'A',c:'#34d399',bg:'rgba(52,211,153,0.08)'},{min:70,g:'B',c:'#0284c7',bg:'rgba(2,132,199,0.08)'},{min:60,g:'C',c:'#d97706',bg:'rgba(217,119,6,0.08)'},{min:50,g:'D',c:'#ea580c',bg:'rgba(234,88,12,0.08)'},{min:0,g:'F',c:'#be123c',bg:'rgba(190,18,60,0.08)'}];
  function calcGrade(){
    const m=parseFloat(document.getElementById('marks_obtained').value);
    const mx=parseFloat(document.getElementById('max_marks').value)||100;
    const l=document.getElementById('grade-letter'),p=document.getElementById('grade-pct'),card=document.getElementById('grade-card');
    if(isNaN(m)){l.textContent='--';l.style.color='#cbd5e1';p.textContent='Enter marks above';card.style.background='#f2f4f6';return;}
    const pct=Math.round((m/mx)*100);
    const gr=gd.find(x=>pct>=x.min)||gd[5];
    l.textContent=gr.g;l.style.color=gr.c;p.textContent=`${m}/${mx} = ${pct}%`;card.style.background=gr.bg;
  }
</script>
</body>
</html>