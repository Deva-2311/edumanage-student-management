<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Students › Add' }) %>
  <div class="page-body" style="max-width:720px">
    <a href="/api/students" style="font-size:0.78rem;color:#64748b;text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:14px">← Back to Students</a>
    <div class="page-header"><div><h1 class="page-title">Add New Student</h1><p class="page-subtitle">Register a new student into the system</p></div></div>
    <% if(error){ %><div class="alert alert-error">✗ <%= error %></div><% } %>
    <div class="card card-body">
      <form method="POST" action="/api/students/add">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div class="form-group"><label class="form-label">Full Name *</label><input type="text" name="name" class="form-input" placeholder="e.g. Raj Kumar" required/></div>
          <div class="form-group"><label class="form-label">Email Address *</label><input type="email" name="email" class="form-input" placeholder="student@college.edu" required/></div>
          <div class="form-group"><label class="form-label">Age *</label><input type="number" name="age" class="form-input" placeholder="21" min="15" max="60" required/></div>
          <div class="form-group">
            <label class="form-label">Department *</label>
            <select name="department" class="form-select" required>
              <option value="">Select department</option>
              <% ['Computer Science & Engineering','Mathematics','Physics','English','Business','History','Electronics & Communication'].forEach(d=>{ %><option><%= d %></option><% }) %>
            </select>
          </div>
          <div class="form-group"><label class="form-label">Phone <span style="color:#94a3b8;font-weight:400">(Optional)</span></label><input type="text" name="phone" class="form-input" placeholder="+91 9876543210"/></div>
          <div class="form-group"><label class="form-label">City <span style="color:#94a3b8;font-weight:400">(Optional)</span></label><input type="text" name="city" class="form-input" placeholder="Chennai"/></div>
        </div>
        <div style="border-top:1px solid #e2e8f0;margin-top:16px;padding-top:16px;display:flex;gap:10px">
          <button type="submit" class="btn btn-primary">+ Add Student</button>
          <a href="/api/students" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>