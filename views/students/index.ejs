<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
  <style>
    /* Table specific overrides for directory */
    .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; }
    .status-pill { display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 99px; font-size: 0.8rem; font-weight: 500; }
    .action-icon { color: #64748b; cursor: pointer; transition: color 0.2s; }
    .action-icon:hover { color: #3b49df; }
    .action-icon.danger:hover { color: #dc2626; }
  </style>
</head>
<body>
<%- include('../partials/sidebar', { currentPage: 'students', user }) %>
<div id="main">
  <!-- Topbar override for search placeholder -->
  <div class="topbar">
    <div class="topbar-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-dim)"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" placeholder="Search students, IDs, or programs..." />
    </div>
    <div class="topbar-right">
      <div class="topbar-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg></div>
      <div class="topbar-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg></div>
      <div class="topbar-user">
        <div class="topbar-avatar" style="background:#f1f5f9; color:#475569">
          <%= (user?.name ?? 'U').charAt(0).toUpperCase() %>
        </div>
      </div>
    </div>
  </div>

  <div class="page-body">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px">
      <div>
        <h1 class="page-title">Student Directory</h1>
        <p class="page-subtitle">Manage academic records for the 2023-2024 semester.</p>
      </div>
      <div style="display:flex; gap:12px">
        <select class="form-select" style="width:180px; padding:8px 12px">
          <option>All Departments</option>
          <option>Computer Science</option>
          <option>Health Sciences</option>
        </select>
        <button class="btn btn-primary" style="padding:8px 16px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          Add Student
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px">
      <div class="card card-body" style="padding:20px">
        <div style="font-size:0.75rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; margin-bottom:8px">TOTAL STUDENTS</div>
        <div style="display:flex; justify-content:space-between; align-items:baseline">
          <div style="font-size:1.8rem; font-weight:800; color:var(--text)">1,284</div>
          <div style="font-size:0.85rem; font-weight:600; color:var(--success); display:flex; align-items:center; gap:4px">
            +4.2% <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
          </div>
        </div>
      </div>
      <div class="card card-body" style="padding:20px">
        <div style="font-size:0.75rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; margin-bottom:8px">ACTIVE NOW</div>
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px">
          <div style="font-size:1.8rem; font-weight:800; color:var(--text)">1,102</div>
        </div>
        <div style="height:6px; background:var(--surface-low); border-radius:3px; overflow:hidden">
          <div style="height:100%; width:85%; background:var(--primary)"></div>
        </div>
      </div>
      <div class="card card-body" style="padding:20px">
        <div style="font-size:0.75rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; margin-bottom:8px">COMPLETION RATE</div>
        <div style="display:flex; justify-content:space-between; align-items:baseline">
          <div style="font-size:1.8rem; font-weight:800; color:var(--text)">92.4%</div>
          <div style="color:var(--success)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
        </div>
      </div>
      <div class="card card-body" style="padding:20px">
        <div style="font-size:0.75rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; margin-bottom:8px">PENDING ACTIONS</div>
        <div style="display:flex; justify-content:space-between; align-items:baseline">
          <div style="font-size:1.8rem; font-weight:800; color:var(--text)">24</div>
          <div style="background:var(--danger-bg); color:var(--danger); font-size:0.7rem; font-weight:700; padding:4px 8px; border-radius:4px">URGENT</div>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="card" style="padding:8px">
      <table class="data-table" style="width:100%">
        <thead>
          <tr>
            <th>STUDENT NAME <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; margin-left:4px"><polygon points="5 15 12 22 19 15"></polygon></svg></th>
            <th>ID NUMBER</th>
            <th>DEPARTMENT</th>
            <th>STATUS</th>
            <th>LAST ACTIVITY</th>
            <th>ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          <!-- Hardcoded sample to exactly match image, then real data injected if available -->
          <% const sample = [
            {n:'Julian Sterling', e:'julian.s@university.edu', id:'882941', d:'Computer Science', s:'Active', sc:'var(--success)', sbg:'var(--success-bg)', t:'2 hours ago'},
            {n:'Amara Miller', e:'amara.m@university.edu', id:'129033', d:'Health Sciences', s:'Completed', sc:'#3b49df', sbg:'var(--primary-light)', t:'May 14, 2024'},
            {n:'Robert Kincaid', e:'robert.k@university.edu', id:'554109', d:'Mechanical Eng.', s:'Dropped', sc:'var(--danger)', sbg:'var(--danger-bg)', t:'3 days ago'},
            {n:'Elena Chen', e:'elena.c@university.edu', id:'990212', d:'Computer Science', s:'Active', sc:'var(--success)', sbg:'var(--success-bg)', t:'6 hours ago'},
            {n:'Marcus Bell', e:'marcus.b@university.edu', id:'102934', d:'Business Admin', s:'Late Pmt', sc:'var(--warning)', sbg:'var(--warning-bg)', t:'Yesterday'}
          ]; %>
          <% sample.forEach((s, idx) => { %>
          <tr>
            <td>
              <div style="display:flex; align-items:center; gap:12px">
                <div style="width:40px; height:40px; border-radius:50%; background:#e2e8f0; display:flex; align-items:center; justify-content:center; overflow:hidden">
                  <img src="https://ui-avatars.com/api/?name=<%= s.n %>&background=random" style="width:100%; height:100%" />
                </div>
                <div>
                  <div style="font-weight:700; color:var(--text); font-size:0.9rem"><%= s.n %></div>
                  <div style="font-size:0.8rem; color:var(--text-dim)"><%= s.e %></div>
                </div>
              </div>
            </td>
            <td>
              <div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; font-family:'JetBrains Mono',monospace">STU-<br/><span style="color:var(--text-dim); font-weight:400"><%= s.id %></span></div>
            </td>
            <td style="color:var(--text-muted); font-size:0.85rem"><%= s.d %></td>
            <td>
              <div class="status-pill" style="background:<%= s.sbg %>; color:<%= s.sc %>">
                <span class="status-dot" style="background:<%= s.sc %>"></span>
                <%= s.s %>
              </div>
            </td>
            <td style="color:var(--text-muted); font-size:0.85rem"><%= s.t %></td>
            <td>
              <div style="display:flex; gap:12px; align-items:center">
                <span class="action-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></span>
                <span class="action-icon" style="color:#3b49df"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></span>
                <span class="action-icon danger" style="color:#dc2626"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></span>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 24px; border-top:1px solid var(--border)">
        <div style="font-size:0.8rem; color:var(--text-dim)">Showing <strong>1</strong> to <strong>5</strong> of <strong>1,284</strong> entries</div>
        <div style="display:flex; gap:4px">
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:0.8rem">‹</button>
          <button class="btn btn-primary" style="padding:6px 12px; font-size:0.8rem; background:#3b49df">1</button>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:0.8rem; border:none; background:transparent">2</button>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:0.8rem; border:none; background:transparent">3</button>
          <span style="padding:6px; color:var(--text-dim)">...</span>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:0.8rem; border:none; background:transparent">257</button>
          <button class="btn btn-secondary" style="padding:6px 12px; font-size:0.8rem">›</button>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>