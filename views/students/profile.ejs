<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Students › Profile' }) %>
  <div class="page-body">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px">
      <a href="/api/students" style="font-size:0.78rem;color:#64748b;text-decoration:none">← Back to Students</a>
      <div style="display:flex;gap:8px">
        <% if(user?.role!=='student'){%><a href="/api/students/<%= student.id %>/edit" class="btn btn-secondary">Edit Profile</a><% }%>
        <% if(user?.role==='admin'){%>
        <form id="ds" method="POST" action="/api/students/<%= student.id %>/delete">
          <button type="button" class="btn btn-danger" onclick="confirmDelete('ds','<%= student.name %>')">Delete</button>
        </form>
        <% }%>
      </div>
    </div>

    <!-- Profile header -->
    <div class="card card-body" style="margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
      <div style="display:flex;align-items:center;gap:14px">
        <div class="avatar avatar-indigo avatar-lg"><%= student.name.charAt(0).toUpperCase() %></div>
        <div>
          <h2 style="font-size:1.15rem;font-weight:700;color:#191c1e;margin:0 0 4px"><%= student.name %></h2>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <span style="font-size:0.72rem;color:#64748b;font-family:'JetBrains Mono',monospace">STU-<%= String(student.id).padStart(4,'0') %></span>
            <span class="badge badge-sky"><%= student.department %></span>
            <span class="badge badge-emerald">Active</span>
          </div>
          <div style="font-size:0.78rem;color:#94a3b8;margin-top:4px"><%= student.email %></div>
        </div>
      </div>
      <div style="display:flex;gap:12px">
        <% [['Courses',student.enrollments?.length??0,'#4f46e5'],['Attendance',student.attendance?.length??0,'#059669'],['Marks',student.marks?.length??0,'#0284c7']].forEach(([l,v,c])=>{ %>
        <div style="text-align:center;padding:10px 16px;border:1px solid #e2e8f0;border-radius:8px;min-width:70px">
          <div style="font-size:1.3rem;font-weight:700;color:<%= c %>"><%= v %></div>
          <div style="font-size:0.68rem;color:#94a3b8;margin-top:2px"><%= l %></div>
        </div>
        <% }) %>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
      <!-- Info -->
      <div class="card">
        <div class="card-header"><span class="card-title">Personal Information</span></div>
        <div class="card-body">
          <% [['Full Name',student.name],['Email',student.email],['Age',student.age+' yrs'],['Phone',student.phone||'—'],['City',student.city||'—'],['Department',student.department]].forEach(([l,v])=>{ %>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:0.8rem">
            <span style="color:#64748b"><%= l %></span><span style="font-weight:500;color:#191c1e"><%= v %></span>
          </div>
          <% }) %>
        </div>
      </div>
      <!-- Courses -->
      <div class="card">
        <div class="card-header"><span class="card-title">Enrolled Courses</span></div>
        <div class="card-body">
          <% if(!student.enrollments?.length){ %>
          <div class="empty-state" style="padding:20px 0"><div class="empty-icon">📋</div><p>No courses enrolled</p></div>
          <% } else { student.enrollments.forEach(e=>{ %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:0.8rem">
            <div><div style="font-weight:500;color:#191c1e"><%= e.course?.course_name %></div><div style="font-size:0.72rem;color:#94a3b8"><%= e.course?.department %></div></div>
            <span class="badge <%=e.status==='active'?'badge-indigo':e.status==='completed'?'badge-emerald':'badge-slate'%>"><%= e.status %></span>
          </div>
          <% }) } %>
        </div>
      </div>
    </div>

    <!-- Marks -->
    <% if(student.marks?.length){ %>
    <div class="card">
      <div class="card-header"><span class="card-title">Academic Records</span></div>
      <table class="data-table">
        <thead><tr><th>Course</th><th>Exam Type</th><th>Score</th><th>%</th><th>Grade</th></tr></thead>
        <tbody>
          <% student.marks.forEach(m=>{ const pct=Math.round((m.marks_obtained/m.max_marks)*100); const gc=m.grade==='A+'?'grade-ap':m.grade==='A'?'grade-a':m.grade==='B'?'grade-b':m.grade==='C'?'grade-c':m.grade==='D'?'grade-d':'grade-f'; %>
          <tr>
            <td style="font-weight:500;color:#191c1e"><%= m.course?.course_name %></td>
            <td><span class="badge badge-violet"><%= m.exam_type %></span></td>
            <td style="font-family:'JetBrains Mono',monospace"><%= m.marks_obtained %>/<%= m.max_marks %></td>
            <td style="font-weight:600;color:<%=pct>=80?'#059669':pct>=60?'#d97706':'#be123c'%>"><%= pct %>%</td>
            <td><span class="badge <%= gc %>"><%= m.grade %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
