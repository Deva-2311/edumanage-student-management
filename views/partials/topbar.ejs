<!-- ── Top Bar ── -->
<div class="topbar">
  <div class="topbar-search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-dim)"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input type="text" placeholder="Search system logs, students, or departments..." />
  </div>
  
  <div class="topbar-right">
    <a href="/api/logs" class="topbar-icon" style="color:inherit" title="System Logs">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
    </a>
    <a href="/api/dashboard" class="topbar-icon" style="color:inherit" title="Dashboard">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
    </a>
    <div class="topbar-user">
      <div class="topbar-user-info">
        <div class="topbar-user-name"><%= user?.name ?? 'Admin User' %></div>
        <div class="topbar-user-role"><%= user?.role === 'admin' ? 'System Administrator' : user?.role %></div>
      </div>
      <div class="topbar-avatar">
        <%= (user?.name ?? 'U').charAt(0).toUpperCase() %>
      </div>
    </div>
  </div>
</div>
