<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Enrollment' }) %>
  <div class="page-body">
    <div class="page-header">
      <div><h1 class="page-title">Enrollment Management</h1><p class="page-subtitle">Manage course enrollments and lifecycle</p></div>
      <% if(user?.role!=='student'){%><button onclick="openModal('enroll-modal')" class="btn btn-primary">+ Enroll Student</button><% }%>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px">
      <% [['Active',active,'#4f46e5'],['Total',total,'#191c1e'],['Completed',completed,'#059669'],['Dropped',dropped,'#64748b']].forEach(([l,v,c])=>{ %>
      <div class="card stat-card"><div class="stat-label"><%= l %></div><div class="stat-value" style="color:<%= c %>"><%= v %></div></div>
      <% }) %>
    </div>

    <% if(typeof error!=='undefined'&&error){ %><div class="alert alert-error">✗ <%= error %></div><% } %>

    <div class="card card-body" style="margin-bottom:14px">
      <form method="GET" action="/api/enrollment" style="display:flex;gap:10px;flex-wrap:wrap">
        <div class="search-wrap" style="flex:1;min-width:200px"><span class="search-icon">🔍</span><input type="text" name="search" value="<%= search %>" placeholder="Search by student or course…" class="form-input"/></div>
        <button type="submit" class="btn btn-primary">Search</button>
        <% if(search){%><a href="/api/enrollment" class="btn btn-secondary">Clear</a><% }%>
      </form>
    </div>

    <div class="card">
      <div style="overflow-x:auto">
        <table class="data-table">
          <thead><tr><th>ID</th><th>Student</th><th>Course</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% if(!enrollments.length){ %>
            <tr><td colspan="6"><div class="empty-state"><div class="empty-icon">📋</div><p>No enrollments found</p></div></td></tr>
            <% } else { enrollments.forEach(e=>{ %>
            <tr>
              <td style="font-family:'JetBrains Mono',monospace;color:#4f46e5;font-size:0.75rem;font-weight:600">ENR-<%= String(e.id).padStart(4,'0') %></td>
              <td><div style="display:flex;align-items:center;gap:8px"><div class="avatar avatar-indigo"><%= (e.student?.name??'?').charAt(0).toUpperCase() %></div><div><div style="font-weight:500;color:#191c1e;font-size:0.82rem"><%= e.student?.name %></div><div style="font-size:0.72rem;color:#94a3b8"><%= e.student?.department %></div></div></div></td>
              <td><%= e.course?.course_name %></td>
              <td style="font-size:0.78rem;color:#64748b"><%= new Date(e.enrolled_at).toLocaleDateString('en-IN') %></td>
              <td><span class="badge <%=e.status==='active'?'badge-indigo':e.status==='completed'?'badge-emerald':'badge-slate'%>"><%= e.status %></span></td>
              <td>
                <div style="display:flex;gap:6px;align-items:center">
                  <% if(user?.role!=='student'){%>
                  <form method="POST" action="/api/enrollment/<%= e.id %>/status">
                    <select name="status" onchange="this.form.submit()" class="form-select" style="padding:4px 8px;font-size:0.72rem;width:auto">
                      <option value="active" <%=e.status==='active'?'selected':''%>>Active</option>
                      <option value="completed" <%=e.status==='completed'?'selected':''%>>Completed</option>
                      <option value="dropped" <%=e.status==='dropped'?'selected':''%>>Dropped</option>
                    </select>
                  </form>
                  <% }%>
                  <% if(user?.role==='admin'){%>
                  <form id="de<%= e.id %>" method="POST" action="/api/enrollment/<%= e.id %>/delete">
                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete('de<%=e.id%>','this enrollment')">Delete</button>
                  </form>
                  <% }%>
                </div>
              </td>
            </tr>
            <% }) } %>
          </tbody>
        </table>
      </div>
      <div class="table-footer">
        <span class="table-meta">Showing <%= Math.min((page-1)*limit+1,total) %> – <%= Math.min(page*limit,total) %> of <%= total %></span>
        <div class="pagination"><% for(let i=1;i<=totalPages;i++){%><a href="/api/enrollment?page=<%=i%>" class="page-btn <%=i===page?'active':''%>"><%=i%></a><% }%></div>
      </div>
    </div>
  </div>
</div>

<div id="enroll-modal" class="modal-overlay">
  <div class="modal">
    <div class="modal-header"><h3 class="modal-title">Enroll Student</h3><button class="modal-close" onclick="closeModal('enroll-modal')">✕</button></div>
    <form method="POST" action="/api/enrollment">
      <div class="form-group"><label class="form-label">Student *</label><select name="student_id" class="form-select" required><option value="">Choose a student…</option><% students.forEach(s=>{%><option value="<%= s.id %>"><%= s.name %> — <%= s.department %></option><% }) %></select></div>
      <div class="form-group" style="margin-bottom:20px"><label class="form-label">Course *</label><select name="course_id" class="form-select" required><option value="">Choose a course…</option><% courses.forEach(c=>{%><option value="<%= c.id %>"><%= c.course_code %> — <%= c.course_name %></option><% }) %></select></div>
      <div style="display:flex;gap:10px"><button type="submit" class="btn btn-primary" style="flex:1">Enroll Now</button><button type="button" onclick="closeModal('enroll-modal')" class="btn btn-secondary" style="flex:1">Cancel</button></div>
    </form>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
