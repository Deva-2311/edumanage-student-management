<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Courses' }) %>
  <div class="page-body">
    <div class="page-header">
      <div><h1 class="page-title">Course Management</h1><p class="page-subtitle">Manage academic courses and instructors</p></div>
      <% if(user?.role==='admin'){%><a href="/api/courses/add" class="btn btn-primary">+ Add Course</a><% }%>
    </div>

    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px">
      <div class="card stat-card"><div class="stat-label">Total Courses</div><div class="stat-value"><%= total %></div></div>
      <div class="card stat-card"><div class="stat-label">Active</div><div class="stat-value" style="color:#059669"><%= courses.filter(c=>c.is_active).length %></div></div>
      <div class="card stat-card"><div class="stat-label">Total Enrolled</div><div class="stat-value" style="color:#4f46e5"><%= courses.reduce((s,c)=>s+(c.enrollments?.length??0),0) %></div></div>
      <div class="card stat-card"><div class="stat-label">Departments</div><div class="stat-value" style="color:#0284c7"><%= [...new Set(courses.map(c=>c.department))].length %></div></div>
    </div>

    <div class="card card-body" style="margin-bottom:14px">
      <form method="GET" action="/api/courses" style="display:flex;gap:10px;flex-wrap:wrap">
        <div class="search-wrap" style="flex:1;min-width:200px"><span class="search-icon">🔍</span><input type="text" name="search" value="<%= search %>" placeholder="Search courses or departments…" class="form-input"/></div>
        <button type="submit" class="btn btn-primary">Search</button>
        <% if(search){%><a href="/api/courses" class="btn btn-secondary">Clear</a><% }%>
      </form>
    </div>

    <div class="card">
      <div style="overflow-x:auto">
        <table class="data-table">
          <thead><tr><th>Code</th><th>Course Name</th><th>Department</th><th>Instructor</th><th>Enrolled</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% if(!courses.length){ %>
            <tr><td colspan="7"><div class="empty-state"><div class="empty-icon">📚</div><p>No courses found</p></div></td></tr>
            <% } else { courses.forEach(c=>{ %>
            <tr>
              <td style="font-family:'JetBrains Mono',monospace;font-weight:600;color:#4f46e5;font-size:0.78rem"><%= c.course_code %></td>
              <td style="font-weight:600;color:#191c1e"><%= c.course_name %></td>
              <td><span class="badge badge-sky"><%= c.department %></span></td>
              <td style="color:#64748b"><%= c.instructor??'—' %></td>
              <td><span class="badge badge-indigo"><%= c.enrollments?.length??0 %> students</span></td>
              <td><span class="badge <%=c.is_active?'badge-emerald':'badge-slate'%>"><%=c.is_active?'Active':'Inactive'%></span></td>
              <td>
                <div style="display:flex;gap:6px">
                  <% if(user?.role!=='student'){%><a href="/api/courses/<%= c.id %>/edit" class="btn btn-secondary btn-sm">Edit</a><% }%>
                  <% if(user?.role==='admin'){%>
                  <form id="dc<%= c.id %>" method="POST" action="/api/courses/<%= c.id %>/delete">
                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete('dc<%=c.id%>','<%=c.course_name%>')">Delete</button>
                  </form>
                  <% }%>
                </div>
              </td>
            </tr>
            <% }) } %>
          </tbody>
        </table>
      </div>
      <div class="table-footer">
        <span class="table-meta">Showing <%= (page-1)*limit+1 %> – <%= Math.min(page*limit,total) %> of <%= total %> courses</span>
        <div class="pagination"><% for(let i=1;i<=totalPages;i++){%><a href="/api/courses?page=<%=i%><%=search?'&search='+search:''%>" class="page-btn <%=i===page?'active':''%>"><%=i%></a><% }%></div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>