<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — EduManage</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/edumanage.css"/>
</head>
<body>
<%- include('../partials/sidebar', { currentPage, user }) %>
<div id="main">
  <%- include('../partials/topbar', { user, breadcrumb:'Attendance › Mark' }) %>
  <div class="page-body" style="max-width:720px">
    <a href="/api/attendance" style="font-size:0.78rem;color:#64748b;text-decoration:none;margin-bottom:14px;display:inline-block">← Back to Attendance</a>
    <div class="page-header"><div><h1 class="page-title">Mark Attendance</h1><p class="page-subtitle">Record student presence for a session</p></div></div>
    <% if(error){ %><div class="alert alert-error">✗ <%= error %></div><% } %>
    <% if(success){ %><div class="alert alert-success">✓ <%= success %></div><% } %>
    <div class="card card-body">
      <form method="POST" action="/api/attendance/mark">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
          <div class="form-group">
            <label class="form-label">Student *</label>
            <select name="student_id" class="form-select" required>
              <option value="">Choose student…</option>
              <% students.forEach(s=>{%><option value="<%= s.id %>"><%= s.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Course *</label>
            <select name="course_id" class="form-select" required>
              <option value="">Choose course…</option>
              <% courses.forEach(c=>{%><option value="<%= c.id %>"><%= c.course_code %> — <%= c.course_name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Date *</label>
            <input type="date" name="date" value="<%= today %>" class="form-input" required/>
          </div>
          <div class="form-group">
            <label class="form-label">Status *</label>
            <div style="display:flex;gap:8px;margin-top:2px">
              <label style="flex:1;display:flex;align-items:center;gap:7px;cursor:pointer;padding:8px 12px;border:1px solid #d1fae5;border-radius:6px;background:rgba(5,150,105,0.06)">
                <input type="radio" name="status" value="present" checked style="accent-color:#059669"/>
                <span style="font-size:0.8rem;font-weight:600;color:#059669">Present</span>
              </label>
              <label style="flex:1;display:flex;align-items:center;gap:7px;cursor:pointer;padding:8px 12px;border:1px solid #fecdd3;border-radius:6px;background:rgba(190,18,60,0.06)">
                <input type="radio" name="status" value="absent" style="accent-color:#be123c"/>
                <span style="font-size:0.8rem;font-weight:600;color:#be123c">Absent</span>
              </label>
              <label style="flex:1;display:flex;align-items:center;gap:7px;cursor:pointer;padding:8px 12px;border:1px solid #fde68a;border-radius:6px;background:rgba(217,119,6,0.06)">
                <input type="radio" name="status" value="late" style="accent-color:#d97706"/>
                <span style="font-size:0.8rem;font-weight:600;color:#d97706">Late</span>
              </label>
            </div>
          </div>
        </div>
        <div style="border-top:1px solid #e2e8f0;padding-top:14px;display:flex;gap:10px">
          <button type="submit" class="btn btn-primary">✓ Mark Attendance</button>
          <a href="/api/attendance" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
